# Discord Developer Portal token
DISCORD_TOKEN=

# Optional: comma-separated guild IDs for faster slash-command registration during development
DISCORD_GUILD_ID=

# Private network address of the VOICEVOX VPS
VOICEVOX_URL=http://10.0.0.12:50021
VOICEVOX_SPEAKER=3

YOMIAGE_SETTINGS_FILE=/var/lib/yomiage-keiryou/settings.json
YOMIAGE_CACHE_DIR=/var/cache/yomiage-keiryou/tts
YOMIAGE_CACHE_TTL=168h
YOMIAGE_CACHE_MAX_BYTES=268435456
YOMIAGE_MAX_AUDIO_BYTES=33554432

# Go memory tuning for a 512MiB VPS
GOMEMLIMIT=128MiB
GOGC=50
