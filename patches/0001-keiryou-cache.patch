+func ttsCacheKey(text string, setting guildSettings) string {
+	setting.Volume = normalizeFloat(setting.Volume, defaultVolume)
+	setting.Speed = normalizeFloat(setting.Speed, defaultSpeed)
+	s := "v1\x00" + text + "\x00" + strconv.Itoa(setting.Speaker) + "\x00" +
+		strconv.FormatFloat(setting.Volume, 'g', -1, 64) + "\x00" +
+		strconv.FormatFloat(setting.Speed, 'g', -1, 64)
+	return fmt.Sprintf("%x", sha256.Sum256([]byte(s)))
+}
+
+func cacheExpired(modTime time.Time, ttl time.Duration) bool {
+	return ttl > 0 && time.Since(modTime) >= ttl
+}
+
+func (b *bot) cleanupTTSCaches(excludePath string) {
+	entries, err := os.ReadDir(b.cacheDir)
+	if err != nil {
+		return
+	}
+	type cacheEntry struct {
+		path    string
+		size    int64
+		modTime time.Time
+	}
+	entriesByTime := make([]cacheEntry, 0, len(entries))
+	var total int64
+	now := time.Now()
+	for _, entry := range entries {
+		if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".wav") {
+			continue
+		}
+		path := filepath.Join(b.cacheDir, entry.Name())
+		info, err := entry.Info()
+		if err != nil {
+			continue
+		}
+		if b.cacheTTL > 0 && now.Sub(info.ModTime()) >= b.cacheTTL && path != excludePath {
+			_ = os.Remove(path)
+			continue
+		}
+		if path == excludePath {
+			continue
+		}
+		total += info.Size()
+		entriesByTime = append(entriesByTime, cacheEntry{path: path, size: info.Size(), modTime: info.ModTime()})
+	}
+	if b.cacheMaxByte <= 0 || total <= b.cacheMaxByte {
+		return
+	}
+	sort.Slice(entriesByTime, func(i, j int) bool { return entriesByTime[i].modTime.Before(entriesByTime[j].modTime) })
+	for _, entry := range entriesByTime {
+		if total <= b.cacheMaxByte {
+			break
+		}
+		if err := os.Remove(entry.path); err == nil {
+			total -= entry.size
+		}
+	}
+}
+
+func normalizeFloat(v, fallback float64) float64 {
+	if math.IsNaN(v) || math.IsInf(v, 0) {
+		return fallback
+	}
+	return v
+}
+
+func envString(name, fallback string) string {
+	if value := strings.TrimSpace(os.Getenv(name)); value != "" {
+		return value
+	}
+	return fallback
+}
+
+func envDuration(name string, fallback time.Duration) time.Duration {
+	if value := strings.TrimSpace(os.Getenv(name)); value != "" {
+		parsed, err := time.ParseDuration(value)
+		if err == nil && parsed > 0 {
+			return parsed
+		}
+	}
+	return fallback
+}
+
+func envInt64(name string, fallback int64) int64 {
+	if value := strings.TrimSpace(os.Getenv(name)); value != "" {
+		parsed, err := strconv.ParseInt(value, 10, 64)
+		if err == nil && parsed > 0 {
+			return parsed
+		}
+	}
+	return fallback
+}
