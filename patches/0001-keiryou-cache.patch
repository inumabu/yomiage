 func (b *bot) synthesizeWithSettings(ctx context.Context, text string, setting guildSettings) ([]byte, error) {
+	tmp, err := os.CreateTemp("", "yomiage-keiryou-*.wav")
+	if err != nil {
+		return nil, err
+	}
+	name := tmp.Name()
+	if err := tmp.Close(); err != nil {
+		os.Remove(name)
+		return nil, err
+	}
+	defer os.Remove(name)
+	if err := b.synthesizeToFile(ctx, text, setting, name); err != nil {
+		return nil, err
+	}
+	return os.ReadFile(name)
+}
+
+func (b *bot) ensureTTSAudio(ctx context.Context, text string, setting guildSettings) (string, error) {
+	setting = normalizeSettings(setting, b.speaker)
+	key := ttsCacheKey(text, setting)
+	path := filepath.Join(b.cacheDir, key+".wav")
+	if info, err := os.Stat(path); err == nil && info.Size() > 0 && !cacheExpired(info.ModTime(), b.cacheTTL) {
+		_ = os.Chtimes(path, time.Now(), time.Now())
+		return path, nil
+	}
+
+	// VOICEVOX は 512MB 環境でのピークメモリを抑えるため、合成は全 guild 共通で直列化する。
+	b.synthMu.Lock()
+	defer b.synthMu.Unlock()
+
+	if info, err := os.Stat(path); err == nil && info.Size() > 0 && !cacheExpired(info.ModTime(), b.cacheTTL) {
+		_ = os.Chtimes(path, time.Now(), time.Now())
+		return path, nil
+	}
+
+	tmp, err := os.CreateTemp(b.cacheDir, ".tts-*.wav.tmp")
+	if err != nil {
+		return "", fmt.Errorf("create TTS cache temp file: %w", err)
+	}
+	tmpName := tmp.Name()
+	if err := tmp.Close(); err != nil {
+		os.Remove(tmpName)
+		return "", fmt.Errorf("close TTS cache temp file: %w", err)
+	}
+	defer os.Remove(tmpName)
+
+	if err := b.synthesizeToFile(ctx, text, setting, tmpName); err != nil {
+		return "", err
+	}
+	if err := os.Rename(tmpName, path); err != nil {
+		return "", fmt.Errorf("commit TTS cache: %w", err)
+	}
+	_ = os.Chtimes(path, time.Now(), time.Now())
+	b.cleanupTTSCaches(path)
+	return path, nil
+}
