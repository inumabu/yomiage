#!/usr/bin/env bash
set -euo pipefail
. /etc/voicevox-engine.env
: "${VOICEVOX_BIN:?VOICEVOX_BINが必要です}"
: "${VOICEVOX_HOST:?VOICEVOX_HOSTが必要です}"
: "${VOICEVOX_PORT:?VOICEVOX_PORTが必要です}"

read -r -a extra_args <<< "${VOICEVOX_EXTRA_ARGS:-}"
exec "$VOICEVOX_BIN" --host "$VOICEVOX_HOST" --port "$VOICEVOX_PORT" "${extra_args[@]}"
