# Discord Bot token
DISCORD_TOKEN=

# Development server ID; leave blank for global commands
DISCORD_GUILD_ID=
VOICEVOX_SPEAKER=3

# VOICEVOX image tag can be overridden here.
VOICEVOX_IMAGE=voicevox/voicevox_engine:latest

# Low-memory tuning
GOMEMLIMIT=128MiB
GOGC=50
YOMIAGE_CACHE_TTL=168h
YOMIAGE_CACHE_MAX_BYTES=268435456
YOMIAGE_MAX_AUDIO_BYTES=33554432
